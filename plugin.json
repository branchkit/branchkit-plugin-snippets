{
  "$schema": "https://branchkit.dev/schemas/manifest.json",
  "id": "snippets",
  "name": "Snippets",
  "version": "0.1.0",
  "min_api_version": "0.1.0",
  "description": "Speak a snippet's name to type its expansion at the cursor. Add your own in Settings.",
  "author": "BranchKit",
  "publisher": "github:branchkit",
  "privileges": ["input"],
  "optional_privileges": ["clipboard"],
  "dev": {
    "build": [
      ["go", "build", "-ldflags=-s -w", "-o", "../snippets-plugin", "."]
    ],
    "build_dir": "src"
  },
  "run": "./snippets-plugin",
  "action_prefix": "snippets",
  "action_types": {
    "type": {
      "label": "Type snippet",
      "fields": [
        {
          "key": "text",
          "label": "Text",
          "field_type": "string",
          "required": true
        }
      ]
    }
  },
  "provides": {
    "collections": {
      "snippets": {
        "preset": "named_entities",
        "fields": [
          {
            "key": "spoken",
            "field_type": "string",
            "label": "Spoken name",
            "required": true
          },
          {
            "key": "expansion",
            "field_type": "string",
            "label": "Typed text",
            "required": true
          },
          {
            "key": "category",
            "field_type": "string",
            "label": "Category"
          }
        ],
        "writers": "anyone_who_declares",
        "merge": "collect",
        "feeds_matching": {
          "type": "as_named_entities",
          "key_field": "spoken",
          "value_field": "expansion"
        },
        "description": "Speakable snippet names and the text each one types. Open to contributions: any plugin that declares this collection may ship a pack of records."
      }
    }
  },
  "collection_data": {
    "voice_commands": "commands.json",
    "snippets": [
      { "spoken": "shrug", "expansion": "¯\\_(ツ)_/¯", "category": "fun" },
      { "spoken": "table flip", "expansion": "(╯°□°)╯︵ ┻━┻", "category": "fun" },
      { "spoken": "disapproval", "expansion": "ಠ_ಠ", "category": "fun" },
      { "spoken": "long dash", "expansion": "—", "category": "typography" },
      { "spoken": "check mark", "expansion": "✓", "category": "typography" },
      { "spoken": "today", "expansion": "{{date}}", "category": "dynamic" },
      { "spoken": "time now", "expansion": "{{time}}", "category": "dynamic" }
    ]
  },
  "consumes": {
    "effects": [
      {
        "asserts": ["signal_clipboard_in_use"],
        "user_visible_name": "Clipboard paste",
        "user_visible_description": "Long and multi-line snippets are delivered by pasting; the clipboard is briefly used and, if permitted, restored."
      }
    ]
  },
  "implements": {
    "on_action": true
  }
}
