{
  "$schema": "https://branchkit.dev/schemas/manifest.json",
  "id": "snippets",
  "name": "Snippets",
  "version": "0.1.0",
  "min_api_version": "0.1.0",
  "description": "Speak a snippet's name to type its expansion at the cursor. Add your own in Settings.",
  "author": "BranchKit",
  "publisher": "github:branchkit",
  "privileges": ["input"],
  "optional_privileges": ["clipboard"],
  "dev": {
    "build": [
      ["go", "build", "-ldflags=-s -w", "-o", "../snippets-plugin", "."]
    ],
    "build_dir": "src"
  },
  "run": "./snippets-plugin",
  "action_prefix": "snippets",
  "action_types": {
    "type": {
      "label": "Type snippet",
      "fields": [
        {
          "key": "text",
          "label": "Text",
          "field_type": "string"
        },
        {
          "key": "name",
          "label": "Snippet name",
          "field_type": "string"
        }
      ]
    }
  },
  "provides": {
    "collections": {
      "snippets": {
        "preset": "named_entities",
        "label": "Snippets",
        "fields": [
          {
            "key": "spoken",
            "field_type": "string",
            "label": "Spoken name",
            "required": true
          },
          {
            "key": "expansion",
            "field_type": "string",
            "label": "Typed text",
            "required": true
          },
          {
            "key": "category",
            "field_type": "string",
            "label": "Category"
          },
          {
            "key": "speakable",
            "field_type": "boolean",
            "label": "Speakable"
          }
        ],
        "writers": "anyone_who_declares",
        "merge": "collect",
        "feeds_matching": {
          "type": "as_named_entities",
          "key_field": "spoken",
          "value_field": "expansion"
        },
        "grammar_only_when": "speakable",
        "description": "Snippet names and the text each one types. Every snippet is selectable by codeword (\"snippet\", then the letter code); a snippet marked speakable ALSO answers to its name (\"snippet shrug\"). Only speakable names enter the recognition grammar — imported packs stay out of the vocabulary until promoted. Open to contributions: any plugin that declares this collection may ship a pack of records."
      }
    }
  },
  "collection_data": {
    "voice_commands": "commands.json",
    "keybinds": {
      "alt+shift+s": { "action": "snippets.type", "params": { "name": "shrug" } }
    },
    "snippets": [
      { "spoken": "shrug", "expansion": "¯\\_(ツ)_/¯", "category": "fun", "speakable": true },
      { "spoken": "table flip", "expansion": "(╯°□°)╯︵ ┻━┻", "category": "fun", "speakable": true },
      { "spoken": "disapproval", "expansion": "ಠ_ಠ", "category": "fun", "speakable": true },
      { "spoken": "long dash", "expansion": "—", "category": "typography", "speakable": true },
      { "spoken": "check mark", "expansion": "✓", "category": "typography", "speakable": true },
      { "spoken": "today", "expansion": "{{date}}", "category": "dynamic", "speakable": true },
      { "spoken": "time now", "expansion": "{{time}}", "category": "dynamic", "speakable": true }
    ]
  },
  "consumes": {
    "effects": [
      {
        "asserts": ["signal_clipboard_in_use"],
        "user_visible_name": "Clipboard paste",
        "user_visible_description": "Long and multi-line snippets are delivered by pasting; the clipboard is briefly used and, if permitted, restored."
      }
    ]
  },
  "implements": {
    "on_action": true
  }
}
